# Backend Socket.IO Server URL
# In development: http://localhost:5000
# In production: https://YOUR-BACKEND-DOMAIN (e.g. on Render, Railway, VPS)
VITE_SOCKET_URL=http://localhost:5000

# Frontend URL for generating remote QR codes and links
